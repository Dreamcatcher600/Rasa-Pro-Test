    "dompurify": "3.4.12",
    "braces": "3.0.3",
    "ws": "8.21.0",
    "rollup": "^4.43.0",
    "@adobe/css-tools": "^4.4.4",
    "prismjs": "^1.30.0",
    "minimatch": "^9.0.7",
    "picomatch": "4.0.4",
    "follow-redirects": "1.16.0",
    "vite": "7.3.5",
    "flatted": "3.4.2",
    "brace-expansion": "2.1.3",
    "socket.io-parser": "4.2.6"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "yarn@4.12.0"
}
