{
  "name": "@rasahq/rasa-inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://europe-west3-npm.pkg.dev/rasa-releases/rasa-inspector/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RasaHQ/rasa-private.git"
  },
  "workspaces": [
    "e2e"
  ],
  "scripts": {
    "dev": "vite",
    "build": "yarn build:spa && yarn build:lib",
    "build:spa": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "yarn workspace inspector-e2e e2e",
    "test:e2e:watch": "yarn workspace inspector-e2e e2e:watch",
    "test:e2e:debug": "yarn workspace inspector-e2e e2e:debug",
    "test:watch": "vitest watch",
    "report:e2e": "yarn workspace inspector-e2e report",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/Inspector/index.d.ts",
      "import": "./dist/lib/inspector.js"
    },
    "./types": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/types.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "peerDependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/pro-light-svg-icons": "7.3.1",
    "@fortawesome/pro-regular-svg-icons": "7.3.1",
    "@fortawesome/pro-solid-svg-icons": "7.3.1",
    "@fortawesome/pro-thin-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/store": "^0.11.1",
    "elkjs": "^0.11.1",
    "immutable-json-patch": "^6.0.3",
    "lodash": "4.18.1",
    "next-themes": "^0.4.6",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^15.6.6",
    "reactflow": "11.11.4",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/pro-light-svg-icons": "7.3.1",
    "@fortawesome/pro-regular-svg-icons": "7.3.1",
    "@fortawesome/pro-solid-svg-icons": "7.3.1",
    "@fortawesome/pro-thin-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@testing-library/dom": "^10.4.1",
